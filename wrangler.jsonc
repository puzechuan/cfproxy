/**
 * For more details about how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cfproxy",
	"main": "src/index.js",
	"compatibility_date": "2026-11-16",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		// 静态页面目录：/login.html 登录注册、/index.html 主页面、/admin.html 用户管理
		"directory": "./public",
		"binding": "ASSETS",
		// 这三个页面必须先经过 Worker 做登录/权限校验，再回读静态文件
		"run_worker_first": ["/", "/index.html", "/login.html", "/admin.html"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cfproxy-users",
			"database_id": "4864ab88-5b74-4414-baf4-80a83e3261ce",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// 管理员用户名（逗号分隔）。这些账号用此用户名注册后自动成为管理员，
		// 因为用户名唯一，别人无法抢注同名管理员账号。
		"ADMIN_USERS": "admin"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
  	},
	"upload_source_maps": true,
	"workers_dev": true,
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// 回源线路优选：按优先级填写可信加速入口，第一项为首选；不配置则直连 GitHub。
	// Workers 无法指定上游 IP（cf.resolveOverride 只对自有 zone 生效），
	// 所以这里换的是入口 URL。/cacheKey 仍基于原始 GitHub URL，换线路不丢缓存。
	// "vars": {
	//   "UPSTREAM_MIRRORS": "[\"https://mirror1.example\", \"https://mirror2.example\"]"
	// }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
